generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IssueStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  FIXED
  OWNER_VERIFICATION
  CLOSED
  REOPENED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String
  createdAt DateTime @default(now())
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String
  type      String
  createdAt DateTime @default(now())
}
